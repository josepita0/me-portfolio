---
import ContactReveal from "./ContactReveal";
import SocialIcon from "./SocialIcon";
import AnimatedText from "./AnimatedText";
import SubmitButtonController from "./SubmitButtonController";
---

<section id="contact" class="contact-section" aria-labelledby="contact-heading">
  <ContactReveal client:visible>
    <div class="contact-section__content">
      <div class="contact-section__intro">
        <div>
          <h2 id="contact-heading" class="contact-section__heading">Hablemos.</h2>
          <AnimatedText client:load text="¿Tienes un proyecto en mente? Trabajemos juntos." class="contact-section__description contact-section__description--animated" delay={0.3} />
        </div>

            <div class="contact-section__socials">
      <!-- <SocialIcon client:load href="https://twitter.com" label="Twitter / X">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
        </svg>
      </SocialIcon> -->
      <SocialIcon client:load href="https://www.linkedin.com/in/jose-acurero/" label="LinkedIn">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
        </svg>
      </SocialIcon>
      <SocialIcon client:load href="https://github.com/josepita0" label="GitHub">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
        </svg>
      </SocialIcon>
    </div>
      </div>

      <form class="contact-section__form" action="https://api.web3forms.com/submit" method="POST">
        <div class="contact-section__field">
          <label class="contact-section__label" for="contact-name">Nombre</label>
          <input
            class="contact-section__input"
            type="text"
            id="contact-name"
            name="name"
            placeholder="Tu nombre"
            required
          />
        </div>
        <div class="contact-section__field">
          <label class="contact-section__label" for="contact-email">Correo</label>
          <input
            class="contact-section__input"
            type="email"
            id="contact-email"
            name="email"
            placeholder="tu@example.com"
            required
          />
        </div>
        <div class="contact-section__field">
          <label class="contact-section__label" for="contact-project">Proyecto</label>
          <textarea
            class="contact-section__textarea"
            id="contact-project"
            name="project"
            rows="5"
            placeholder="Cuéntame sobre tu proyecto..."
            required
          ></textarea>
        </div>
        <div class="contact-section__legal-notice">
          <p>
            Tus datos serán tratados por José Pita con la finalidad de responder tu consulta.
             Puedes ejercer tus derechos de acceso, rectificación, cancelación y oposición en Joseacureropita0@gmail.com.
            <a href="/privacidad" class="contact-section__legal-link">Más información</a>
          </p>
        </div>
        <div class="contact-section__field contact-section__field--checkbox">
          <label class="contact-section__checkbox-label">
            <input
              type="checkbox"
              id="contact-consent"
              name="consent"
              required
              class="contact-section__checkbox"
            />
            <span class="contact-section__checkbox-text">
              He leído y acepto la <a href="/privacidad" target="_blank">política de privacidad</a>
            </span>
          </label>
        </div>
        <input type="hidden" name="access_key" value={import.meta.env.PUBLIC_WEB3FORMS_KEY} />
        <input type="hidden" name="subject" value="Nuevo contacto desde el portafolio" />
        <input type="hidden" name="from_name" value="Formulario de contacto del portafolio" />
        <input type="hidden" name="policy_version" value="1.0" />
        <SubmitButtonController client:load />
        <div class="contact-section__feedback" role="status" aria-live="polite"></div>
      </form>
    </div>


  </ContactReveal>
</section>

<script>
  // Web3Forms integration — progressive enhancement (form still submits without JS).
  // Get your access key at https://web3forms.com
  // Replace YOUR_WEB3FORMS_ACCESS_KEY in the hidden input above with your real key.

  function dispatchStatus(status: string) {
    window.dispatchEvent(
      new CustomEvent("web3forms:status", { detail: { status } }),
    );
  }

  function showFeedback(
    el: HTMLElement,
    message: string,
    type: "success" | "error",
  ) {
    el.textContent = message;
    el.className = `contact-section__feedback contact-section__feedback--${type}`;
    // Force reflow so the fade-in animation replays
    void el.offsetWidth;
    el.classList.add("contact-section__feedback--visible");
  }

  function clearFeedback(el: HTMLElement) {
    el.classList.remove("contact-section__feedback--visible");
    // Wait for fade-out transition before clearing text
    setTimeout(() => {
      el.textContent = "";
      el.className = "contact-section__feedback";
    }, 300);
  }

  document.addEventListener("DOMContentLoaded", () => {
    const form = document.querySelector<HTMLFormElement>(
      ".contact-section__form",
    );
    if (!form) return;

    const feedback = form.querySelector<HTMLElement>(
      ".contact-section__feedback",
    );
    if (!feedback) return;

    form.addEventListener("submit", async (e) => {
      // Progressive enhancement: only intercept if JS is available
      e.preventDefault();
      dispatchStatus("loading");
      clearFeedback(feedback);

      // Validate consent checkbox
      const consent = form.querySelector<HTMLInputElement>("#contact-consent");
      if (!consent || !consent.checked) {
        dispatchStatus("error");
        showFeedback(
          feedback,
           "Debes aceptar la política de privacidad",
          "error"
        );
        setTimeout(() => clearFeedback(feedback), 5000);
        return;
      }

      const data = new FormData(form);
      const payload: Record<string, string> = {};
      data.forEach((value, key) => {
        payload[key] = String(value);
      });

      // Add timestamp and policy version to payload
      payload.timestamp = new Date().toISOString();
      payload.policy_version = "1.0";

      try {
        const res = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });

        const result = await res.json();

        if (result.success) {
          dispatchStatus("success");
          showFeedback(
            feedback,
            "\u00a1Mensaje enviado correctamente!",
            "success",
          );
          form.reset();
          // Reset button to idle after 3s
          setTimeout(() => dispatchStatus("idle"), 3000);
        } else {
          throw new Error(result.message || "Submission failed");
        }
      } catch {
        dispatchStatus("error");
        showFeedback(
          feedback,
           "Hubo un error. Por favor, intenta de nuevo.",
          "error",
        );
      }

      // Clear feedback after 5s
      setTimeout(() => clearFeedback(feedback), 5000);
    });
  });
</script>
